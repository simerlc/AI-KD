# AI快搭 V1 - api 配置 (示例模板)

# LLM Provider 配置
# 可选: Ollama 本地 / 阿里云 DashScope / OpenAI 兼容接口
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash-0731
LLM_SUPPORTS_IMAGES=True

# 服务端口
# 前端 vite.config.ts 会自动读取本文件的 PORT 作为代理 target，无需手动改前端代码。
PORT=3001

# 沙箱模式（node=本地子进程，无需 Docker；docker=Docker 容器模式，需本机安装 Docker）
SANDBOX_MODE=docker
