{
  "name": "@aikd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./agent/persistence.service": "./src/agent/persistence.service.ts"
  },
  "scripts": {
    "dev": "cross-env DOTENVX_PATH=.env tsx watch --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.0.0",
    "@aikd/shared": "workspace:*",
    "@aikd/agent": "workspace:*",
    "@aikd/app-engine": "workspace:*",
    "@aikd/component-registry": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.36.4",
    "fflate": "^0.8.2",
    "hono": "^4.7.0",
    "jose": "^6.1.3",
    "nanoid": "^5.1.6",
    "openai": "^4.77.0",
    "uuid": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "vitest": "^3.2.0"
  }
}
